DATABASE_URL=

JWT_SECRET=
JWT_EXPIRES_IN=7d

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

PORT=3001
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Email via Gmail + Nodemailer (Google App Password required)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=JollofPlate <your-gmail@gmail.com>

# In-process keep-alive (pings every 5 minutes while this API is running)
# Include API + web Render URLs so they keep each other warm.
KEEP_ALIVE_URLS=https://jollofplate-api-develop.onrender.com,https://jollofplate-web-develop.onrender.com

# Seed admin (used by prisma/seed.ts)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=
