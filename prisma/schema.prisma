generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

/// Custom shopping / house-stock requests (no online prices — quote on WhatsApp)
enum SourcingRequestStatus {
  PENDING
  CANCELLED
  COMPLETED
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Customer {
  id                 String            @id @default(cuid())
  email              String            @unique
  passwordHash       String
  firstName          String
  lastName           String
  phone              String?
  role               String            @default("customer")
  emailVerifiedAt    DateTime?
  emailVerifyToken   String?           @unique
  emailVerifyExpires DateTime?
  orders             Order[]
  sourcingRequests   SourcingRequest[]
  addresses          CustomerAddress[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

model CustomerAddress {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// Friendly name e.g. "Home", "Office"
  label      String?
  line1      String
  line2      String?
  city       String
  state      String?
  landmark   String?
  phone      String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId])
}

model Category {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  image       String?
  description String?
  status      CategoryStatus @default(ACTIVE)
  sortOrder   Int            @default(0)
  meals       Meal[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status, sortOrder])
}

model Meal {
  id              String      @id @default(cuid())
  name            String
  slug            String      @unique
  description     String      @default("")
  /// Whole Naira (₦), not kobo
  price           Int
  /// Whole Naira (₦), optional sale price
  discountPrice   Int?
  categoryId      String
  category        Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images          String[]
  /// Preparation time in minutes
  preparationTime Int?
  featured        Boolean     @default(false)
  bestSeller      Boolean     @default(false)
  available       Boolean     @default(true)
  ingredients     String?
  /// Optional add-ons: [{ "name": string, "price": number }]
  extras          Json?
  orderItems      OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([categoryId])
  @@index([available])
  @@index([featured])
  @@index([bestSeller])
  @@index([slug])
}

/// Singleton restaurant profile (enforce one row in app layer)
model RestaurantSettings {
  id             String   @id @default(cuid())
  restaurantName String
  whatsappNumber String
  contactNumber  String?
  email          String?
  address        String?
  businessHours  Json?
  deliveryFee    Int      @default(0)
  socialLinks    Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  customerId  String
  customer    Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  status      OrderStatus @default(PENDING)
  subtotal    Int
  deliveryFee Int         @default(0)
  total       Int
  /// Street / house number / estate
  deliveryLine1    String
  /// Apartment, floor, etc. (optional)
  deliveryLine2    String?
  deliveryCity     String
  deliveryState    String?
  deliveryLandmark String?
  /// Phone for the rider / delivery contact (optional; falls back to customer phone)
  deliveryPhone    String?
  notes       String?
  paidAt      DateTime?
  items       OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([orderNumber])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  mealId    String?
  meal      Meal?    @relation(fields: [mealId], references: [id], onDelete: SetNull)
  name      String
  unitPrice Int
  quantity  Int
  extras    Json?
  lineTotal Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([mealId])
}

/// Curated list of items JollofPlate can help source (no prices online)
model SourcingItem {
  id          String               @id @default(cuid())
  name        String
  slug        String               @unique
  description String               @default("")
  image       String?
  /// e.g. "bag", "carton", "pack" — display hint only
  unitHint    String?
  available   Boolean              @default(true)
  sortOrder   Int                  @default(0)
  requestItems SourcingRequestItem[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([available, sortOrder])
  @@index([slug])
}

/// Customer "stock my house" request — separate from menu orders
model SourcingRequest {
  id               String                @id @default(cuid())
  requestNumber    String                @unique
  customerId       String
  customer         Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  status           SourcingRequestStatus @default(PENDING)
  deliveryLine1    String
  deliveryLine2    String?
  deliveryCity     String
  deliveryState    String?
  deliveryLandmark String?
  deliveryPhone    String?
  notes            String?
  items            SourcingRequestItem[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([requestNumber])
}

model SourcingRequestItem {
  id             String          @id @default(cuid())
  requestId      String
  request        SourcingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  /// Null when the customer typed a custom item not on the list
  sourcingItemId String?
  sourcingItem   SourcingItem?   @relation(fields: [sourcingItemId], references: [id], onDelete: SetNull)
  name           String
  /// Optional — customer may omit quantity
  quantity       Int?
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([requestId])
  @@index([sourcingItemId])
}
